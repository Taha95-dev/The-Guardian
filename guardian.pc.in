prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: The Guardian
Description: A language framework with custom binary formats and VM
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lguardian_core -lguardian_vm -lguardian_compiler -lom
Cflags: -I${includedir}/guardian

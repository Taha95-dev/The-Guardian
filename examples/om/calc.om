// Simple calculator
fn main() {
    let a = 10;
    let b = 20;
    let sum = a + b;
    let diff = b - a;
    let product = a * b;
    let quotient = b / a;
    
    println("Sum: ");
    println(sum);
    println("Diff: ");
    println(diff);
    println("Product: ");
    println(product);
    println("Quotient: ");
    println(quotient);
}

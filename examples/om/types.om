// All supported types
fn main() {
    let int_val = 42;
    let float_val = 3.14159;
    let bool_val = true;
    let string_val = "Om is awesome!";
    let char_val = 'O';
    
    println("Integer: ");
    println(int_val);
    println("Float: ");
    println(float_val);
    println("Boolean: ");
    println(bool_val);
    println("String: ");
    println(string_val);
    println("Character: ");
    println(char_val);
}

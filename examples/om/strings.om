// String operations
fn main() {
    let msg = "Om is a systems language";
    let year = 2026;
    let pi = 3.14159;
    let active = true;
    
    println("Message: ");
    println(msg);
    println("Year: ");
    println(year);
    println("Pi: ");
    println(pi);
    println("Active: ");
    println(active);
    
    // String concatenation (when supported)
    let name = "Taha";
    let greeting = "Hello, " + name;
    println(greeting);
}
